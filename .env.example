APP_NAME="Fête du Cidre"
APP_URL=http://localhost:8080
APP_ENV=development
APP_DEBUG=true
APP_KEY=GENERATE_UNE_CLE_RANDOM_64_CHARS

DB_HOST=localhost
DB_PORT=3306
DB_NAME=fete_cidre
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

CACHE_ENABLED=false
CACHE_TTL=3600
CACHE_PAGES_TTL=86400

MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@fetecidre.fr
MAIL_FROM_NAME="Fête du Cidre"
MAIL_ENCRYPTION=tls

IMAGE_MAX_WIDTH=1920
IMAGE_QUALITY_WEBP=82
IMAGE_QUALITY_AVIF=68
IMAGE_SIZES=800,400,200

STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

ADMIN_PATH=/admin
ADMIN_SESSION_LIFETIME=7200

MAINTENANCE_ENABLED=false
MAINTENANCE_SECRET=dev-bypass-token
