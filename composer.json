{
    "name": "fete-du-cidre/cms",
    "description": "CMS sur-mesure Fête du Cidre",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "vlucas/phpdotenv": "^5.6",
        "intervention/image": "^3.0",
        "phpmailer/phpmailer": "^6.9",
        "dompdf/dompdf": "^2.0",
        "stripe/stripe-php": "^13.0 || ^14.0 || ^15.0 || ^16.0"
    },
    "require-dev": {
        "matthiasmullie/minify": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/html.php",
            "app/Helpers/text.php",
            "app/Helpers/date.php",
            "app/Helpers/icons.php"
        ]
    }
}
